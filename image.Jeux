package main

import (
    "log"
    "net/http"
)

func main() {
    // sert tout le dossier ./static sur la racine "/"
    fs := http.FileServer(http.Dir("./static"))
    http.Handle("/", fs)

    log.Println("Serving on http://localhost:8080")
    log.Fatal(http.ListenAndServe(":8080", nil))
}
